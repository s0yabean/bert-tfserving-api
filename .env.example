# Copy to .env and adjust. All values are optional; defaults shown.
# Inside docker compose, TF_SERVING_URL, MODEL_NAME and LABELS_PATH are set by docker-compose.yml.
TF_SERVING_URL=http://localhost:8501
MODEL_NAME=text_classifier
# Must be the same Hugging Face repo the model was exported from (vocab.txt is taken from it).
HF_TOKENIZER_ID=nlptown/bert-base-multilingual-uncased-sentiment
TOKENIZER_LOWERCASE=true
LABELS_PATH=
MAX_SEQ_LENGTH=256
MAX_TEXT_CHARS=5000
TF_SERVING_CONNECT_TIMEOUT_S=2
TF_SERVING_READ_TIMEOUT_S=10
# Leave empty to send no CORS header; set to one origin, e.g. https://app.example.com
CORS_ORIGIN=
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
